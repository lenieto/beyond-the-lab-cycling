{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Entrenamiento XGBoost\n",
    "**Universidad de los Andes - Semillero EMBS**\n",
    "\n",
    "Este notebook entrena un modelo XGBoost con las características extraídas por TSFEL."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Importar librerías"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from pathlib import Path\n",
    "\n",
    "# Machine learning\n",
    "import xgboost as xgb\n",
    "from sklearn.model_selection import LeaveOneGroupOut\n",
    "from sklearn.metrics import classification_report, confusion_matrix, accuracy_score\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Configuración de matplotlib\n",
    "plt.rcParams.update({\n",
    "    'figure.facecolor': \"#ffffff\",\n",
    "    'axes.facecolor': \"#ffffff\",\n",
    "    'axes.edgecolor': '#1a3a5c',\n",
    "    'axes.labelcolor': \"#000000\",\n",
    "    'axes.titlecolor': '#F0F2F5',\n",
    "    'xtick.color': \"#000000\",\n",
    "    'ytick.color': \"#000000\",\n",
    "    'grid.color': \"#a4b0bc\",\n",
    "    'text.color': \"#000000\",\n",
    "    'font.family': 'monospace',\n",
    "})\n",
    "\n",
    "COLOR_INICIAL = '#00a3e0'\n",
    "COLOR_FATIGA  = '#78be20'"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Cargar dataset de características"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "BASE = Path('..')\n",
    "OUTPUTS = BASE / 'outputs'\n",
    "\n",
    "# Cargar características extraídas\n",
    "df_features = pd.read_csv(OUTPUTS / 'data' / 'features_tsfel.csv')\n",
    "\n",
    "print(f'Dataset cargado: {df_features.shape}')\n",
    "print(f'\\nColumnas: {list(df_features.columns[:10])}... (primeras 10)')\n",
    "\n",
    "# Separar features de metadata\n",
    "feature_cols = [col for col in df_features.columns if col not in ['sujeto', 'y']]\n",
    "print(f'\\nTotal de características: {len(feature_cols)}')\n",
    "\n",
    "df_features.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Preparar datos para entrenamiento"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Preparar matrices X, y, groups\n",
    "X = df_features[feature_cols].values\n",
    "y = df_features['y'].values\n",
    "groups = df_features['sujeto'].values\n",
    "\n",
    "# Manejar posibles NaN o Inf\n",
    "X = np.nan_to_num(X, nan=0.0, posinf=1e6, neginf=-1e6)\n",
    "\n",
    "print(f'X shape: {X.shape}')\n",
    "print(f'y shape: {y.shape}')\n",
    "print(f'\\nSujetos únicos: {np.unique(groups)}')\n",
    "print(f'\\nBalance de clases:')\n",
    "print(f'Inicial (0): {(y==0).sum()}')\n",
    "print(f'Fatiga (1):  {(y==1).sum()}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Entrenamiento LOSO (Leave-One-Subject-Out)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print('Iniciando entrenamiento LOSO...')\n",
    "\n",
    "logo = LeaveOneGroupOut()\n",
    "resultados_loso = []\n",
    "\n",
    "for fold_idx, (train_idx, test_idx) in enumerate(logo.split(X, y, groups)):\n",
    "    sujeto_test = groups[test_idx[0]]\n",
    "    \n",
    "    print(f'\\nFold {fold_idx+1}/5: Test = {sujeto_test}')\n",
    "    print('-'*70)\n",
    "    \n",
    "    X_train, X_test = X[train_idx], X[test_idx]\n",
    "    y_train, y_test = y[train_idx], y[test_idx]\n",
    "    \n",
    "    print(f'Train: {len(X_train)} | Test: {len(X_test)}')\n",
    "    \n",
    "    # Escalar características\n",
    "    scaler = StandardScaler()\n",
    "    X_train_scaled = scaler.fit_transform(X_train)\n",
    "    X_test_scaled = scaler.transform(X_test)\n",
    "    \n",
    "    # Entrenar XGBoost\n",
    "    model = xgb.XGBClassifier(\n",
    "        n_estimators=100,\n",
    "        max_depth=3,\n",
    "        learning_rate=0.1,\n",
    "        subsample=0.8,\n",
    "        colsample_bytree=0.8,\n",
    "        random_state=42,\n",
    "        eval_metric='logloss',\n",
    "        use_label_encoder=False\n",
    "    )\n",
    "    \n",
    "    model.fit(X_train_scaled, y_train, verbose=False)\n",
    "    \n",
    "    # Predicciones\n",
    "    y_pred = model.predict(X_test_scaled)\n",
    "    y_pred_proba = model.predict_proba(X_test_scaled)[:, 1]\n",
    "    \n",
    "    # Métricas\n",
    "    acc = accuracy_score(y_test, y_pred)\n",
    "    print(f'\\nAccuracy: {acc:.4f}')\n",
    "    print('\\nReporte:')\n",
    "    print(classification_report(y_test, y_pred, \n",
    "                                target_names=['Inicial', 'Fatiga'],\n",
    "                                zero_division=0))\n",
    "    \n",
    "    # Guardar resultados\n",
    "    resultados_loso.append({\n",
    "        'sujeto_test': sujeto_test,\n",
    "        'accuracy': acc,\n",
    "        'y_true': y_test,\n",
    "        'y_pred': y_pred,\n",
    "        'y_pred_proba': y_pred_proba,\n",
    "        'model': model,\n",
    "        'scaler': scaler,\n",
    "        'feature_importance': model.feature_importances_\n",
    "    })\n",
    "\n",
    "print('Entrenamiento completado')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Resultados consolidados"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Tabla de resultados\n",
    "print('Accuracy por sujeto:')\n",
    "\n",
    "accs = []\n",
    "for r in resultados_loso:\n",
    "    print(f'  {r[\"sujeto_test\"]:12s}: {r[\"accuracy\"]:.4f}')\n",
    "    accs.append(r['accuracy'])\n",
    "\n",
    "print(f'PROMEDIO: {np.mean(accs):.4f} ± {np.std(accs):.4f}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Guardar resultados\n",
    "df_resultados = pd.DataFrame([{\n",
    "    'Sujeto_test': r['sujeto_test'],\n",
    "    'Accuracy': round(r['accuracy'], 4),\n",
    "} for r in resultados_loso])\n",
    "\n",
    "df_resultados.loc[len(df_resultados)] = {\n",
    "    'Sujeto_test': 'PROMEDIO',\n",
    "    'Accuracy': round(np.mean(accs), 4),\n",
    "}\n",
    "\n",
    "df_resultados.to_excel(OUTPUTS / 'metrics' / 'xgboost_resultados_loso.xlsx', index=False)\n",
    "print('\\n Resultados guardados en: outputs/metrics/xgboost_resultados_loso.xlsx')\n",
    "\n",
    "df_resultados"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Análisis de Feature Importance"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Promediar importancia across folds\n",
    "importancias_promedio = np.mean([r['feature_importance'] for r in resultados_loso], axis=0)\n",
    "\n",
    "df_importancia = pd.DataFrame({\n",
    "    'feature': feature_cols,\n",
    "    'importance': importancias_promedio\n",
    "}).sort_values('importance', ascending=False)\n",
    "\n",
    "print('Top 20 características más importantes:')\n",
    "print(df_importancia.head(20).to_string(index=False))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Gráfico de top 15\n",
    "top_features = df_importancia.head(15)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 8))\n",
    "y_pos = np.arange(len(top_features))\n",
    "ax.barh(y_pos, top_features['importance'], color=COLOR_FATIGA, alpha=0.9)\n",
    "ax.set_yticks(y_pos)\n",
    "ax.set_yticklabels(top_features['feature'], fontsize=9)\n",
    "ax.invert_yaxis()\n",
    "ax.set_xlabel('Importancia')\n",
    "ax.set_title('Top 15 Características Más Importantes (XGBoost)')\n",
    "ax.grid(axis='x')\n",
    "plt.tight_layout()\n",
    "plt.savefig(OUTPUTS / 'figures' / 'feature_importance_top15.png',\n",
    "            dpi=150, bbox_inches='tight', facecolor='#0a0f14')\n",
    "plt.show()\n",
    "\n",
    "print('Gráfico guardado')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Guardar feature importance\n",
    "df_importancia.to_excel(OUTPUTS / 'metrics' / 'xgboost_feature_importance.xlsx', index=False)\n",
    "print('Importancia guardada en: outputs/metrics/xgboost_feature_importance.xlsx')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Análisis por dominio y ángulo"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Clasificar por dominio\n",
    "def clasificar_dominio(feature_name):\n",
    "    if any(x in feature_name.lower() for x in ['mean', 'std', 'variance', 'max', 'min', 'rms']):\n",
    "        return 'Estadístico'\n",
    "    elif any(x in feature_name.lower() for x in ['fft', 'frequency', 'spectral', 'power']):\n",
    "        return 'Frecuencial'\n",
    "    elif any(x in feature_name.lower() for x in ['zero', 'slope', 'diff']):\n",
    "        return 'Temporal'\n",
    "    else:\n",
    "        return 'Otro'\n",
    "\n",
    "df_importancia['dominio'] = df_importancia['feature'].apply(clasificar_dominio)\n",
    "\n",
    "print('Importancia por dominio:')\n",
    "for dominio, imp in df_importancia.groupby('dominio')['importance'].sum().sort_values(ascending=False).items():\n",
    "    n_features = (df_importancia['dominio'] == dominio).sum()\n",
    "    print(f'{dominio:<20}: {imp:.4f} (en {n_features} características)')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Clasificar por ángulo\n",
    "def extraer_angulo(feature_name):\n",
    "    for angulo in ['Rodilla_I', 'Cadera_I', 'Tronco', 'Tobillo_I']:\n",
    "        if angulo in feature_name:\n",
    "            return angulo\n",
    "    return 'Desconocido'\n",
    "\n",
    "df_importancia['angulo'] = df_importancia['feature'].apply(extraer_angulo)\n",
    "\n",
    "print('\\nImportancia por ángulo:')\n",
    "for angulo, imp in df_importancia.groupby('angulo')['importance'].sum().sort_values(ascending=False).items():\n",
    "    n_features = (df_importancia['angulo'] == angulo).sum()\n",
    "    print(f'{angulo:<20}: {imp:.4f} (en {n_features} características)')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "## 8. Análisis de Estabilidad (Múltiples Seeds)\n",
    "\n",
    "print('='*70)\n",
    "print('PROBANDO ESTABILIDAD CON DIFERENTES SEEDS')\n",
    "print('='*70)\n",
    "\n",
    "SEEDS_TO_TEST = [42, 123, 456, 789, 999]\n",
    "resultados_por_seed = []\n",
    "\n",
    "for seed in SEEDS_TO_TEST:\n",
    "    print(f'\\n{\"=\"*70}')\n",
    "    print(f'Entrenando con seed = {seed}')\n",
    "    print(f'{\"=\"*70}')\n",
    "    \n",
    "    np.random.seed(seed)\n",
    "    \n",
    "    # LOSO Cross-Validation\n",
    "    logo = LeaveOneGroupOut()\n",
    "    accs_temp = []\n",
    "    \n",
    "    for fold_idx, (train_idx, test_idx) in enumerate(logo.split(X, y, groups)):\n",
    "        sujeto_test = groups[test_idx[0]]\n",
    "        \n",
    "        X_train, X_test = X[train_idx], X[test_idx]\n",
    "        y_train, y_test = y[train_idx], y[test_idx]\n",
    "        \n",
    "        # Escalar\n",
    "        scaler = StandardScaler()\n",
    "        X_train_scaled = scaler.fit_transform(X_train)\n",
    "        X_test_scaled  = scaler.transform(X_test)\n",
    "        \n",
    "        # Entrenar XGBoost con el seed actual\n",
    "        model = xgb.XGBClassifier(\n",
    "            n_estimators=100,\n",
    "            max_depth=3,\n",
    "            learning_rate=0.1,\n",
    "            subsample=0.8,\n",
    "            colsample_bytree=0.8,\n",
    "            random_state=seed,  # Seed\n",
    "            eval_metric='logloss',\n",
    "            use_label_encoder=False\n",
    "        )\n",
    "        \n",
    "        model.fit(X_train_scaled, y_train, verbose=False)\n",
    "        y_pred = model.predict(X_test_scaled)\n",
    "        acc = accuracy_score(y_test, y_pred)\n",
    "        accs_temp.append(acc)\n",
    "        \n",
    "        print(f'  {sujeto_test}: {acc:.4f}')\n",
    "    \n",
    "    # Guardar resultados de este seed\n",
    "    resultados_por_seed.append({\n",
    "        'seed': seed,\n",
    "        'accuracies': accs_temp.copy(),\n",
    "        'mean': np.mean(accs_temp),\n",
    "        'std': np.std(accs_temp)\n",
    "    })\n",
    "    print(f'\\nPromedio con seed {seed}: {np.mean(accs_temp):.4f} ± {np.std(accs_temp):.4f}')\n",
    "\n",
    "print('RESUMEN DE ESTABILIDAD')\n",
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Crear tabla comparativa\n",
    "df_stability = pd.DataFrame(resultados_por_seed)\n",
    "df_stability['accuracies_str'] = df_stability['accuracies'].apply(\n",
    "    lambda x: ', '.join([f'{a:.3f}' for a in x])\n",
    ")\n",
    "\n",
    "print('\\nResultados por seed:')\n",
    "print(df_stability[['seed', 'mean', 'std']].to_string(index=False))\n",
    "\n",
    "# Calcular variabilidad entre seeds\n",
    "means = df_stability['mean'].values\n",
    "print(f'\\n\\nVariabilidad entre seeds:')\n",
    "print(f'  Mean accuracy: {np.mean(means):.4f}')\n",
    "print(f'  Std entre seeds: {np.std(means):.4f}')\n",
    "print(f'  Rango: [{np.min(means):.4f}, {np.max(means):.4f}]')\n",
    "\n",
    "# Guardar resultados\n",
    "df_stability.to_excel(OUTPUTS / 'metrics' / 'xgboost_stability_analysis.xlsx', \n",
    "                      index=False)\n",
    "print('\\n Análisis guardado en: outputs/metrics/xgboost_stability_analysis.xlsx')"
   ]
  }
 ],
